{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orders-app-client3-old-client",
  "main": "worker/index.ts",
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CLIENT3_INSTALLATION": "1",
    "CLIENT3_WATCHES": "1",
    "CLIENT3_BOOTSTRAP_SHA256": "d12cfd35245c69573b1a7609d66c440943f9ba40d0b33e3a33912e550865632a"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "orders_db_client3_old_client",
    "database_id": "0717f239-6d81-4837-8586-777d94e22c53",
    "migrations_dir": "migrations/client3-watch"
  }],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "upload_source_maps": true
}
